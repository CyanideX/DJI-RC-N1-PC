<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RCN1Bridge</AssemblyName>
    <RootNamespace>RCN1Bridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF owns DPI through the manifest; the WinForms analyzer only fires because of the tray icon -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; its names clash with WPF's -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon-256.png" />
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon-256-light.png" />
    <Resource Include="Assets\icon-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RCN1Bridge.Core\RCN1Bridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
