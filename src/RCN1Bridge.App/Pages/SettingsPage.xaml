<UserControl
    x:Class="RCN1Bridge.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="32,12,32,32">
        <TextBlock Margin="0,0,0,16" Style="{StaticResource PageTitle}" Text="Settings" />

        <Border Margin="0,0,0,14" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock FontWeight="SemiBold" Text="Keep running in the tray when closed" />
                        <TextBlock Style="{StaticResource Muted}" Text="The controller keeps working while the window is hidden. Quit from the tray icon." />
                    </StackPanel>
                    <ui:ToggleSwitch
                        x:Name="KeepInTrayToggle"
                        HorizontalAlignment="Right"
                        Checked="OnKeepInTrayChanged"
                        Unchecked="OnKeepInTrayChanged" />
                </Grid>
                <Border Margin="0,12,0,0" Style="{StaticResource RowDivider}">
                    <Grid>
                        <StackPanel Margin="0,0,80,0">
                            <TextBlock FontWeight="SemiBold" Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Muted}" Text="Opens minimised to the tray, ready for when you plug in the controller" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            x:Name="StartWithWindowsToggle"
                            HorizontalAlignment="Right"
                            Checked="OnStartWithWindowsChanged"
                            Unchecked="OnStartWithWindowsChanged" />
                    </Grid>
                </Border>
                <Border Padding="0,12,0,0" Style="{StaticResource RowDivider}">
                    <Grid>
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock FontWeight="SemiBold" Text="Theme" />
                            <TextBlock Style="{StaticResource Muted}" Text="Follows Windows unless you pick one" />
                        </StackPanel>
                        <ComboBox
                            x:Name="ThemeBox"
                            Width="180"
                            HorizontalAlignment="Right"
                            SelectionChanged="OnThemeChanged" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,14" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,300,0">
                        <TextBlock FontWeight="SemiBold" Text="Send the controller to" />
                        <TextBlock x:Name="OutputHint" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <ComboBox
                        x:Name="OutputBox"
                        Width="280"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        SelectionChanged="OnOutputChanged" />
                </Grid>
                <Border Margin="0,12,0,0" Padding="0,12,0,0" Style="{StaticResource RowDivider}">
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="Mods reading the RC" />
                        <TextBlock
                            x:Name="GameLinkText"
                            Margin="200,0,0,0"
                            HorizontalAlignment="Right"
                            Style="{StaticResource Muted}"
                            TextAlignment="Right"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border Margin="0,0,0,14" Style="{StaticResource Card}">
            <Grid>
                <StackPanel Margin="0,0,280,0">
                    <TextBlock FontWeight="SemiBold" Text="Virtual controller driver" />
                    <TextBlock x:Name="DriverText" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Click="OnDriverDownloadClicked" Content="Download ViGEmBus" />
                    <ui:Button Click="OnDriverCheckClicked" Content="Check again" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
            <Grid>
                <StackPanel Margin="0,0,320,0">
                    <TextBlock x:Name="AboutText" FontWeight="SemiBold" />
                    <TextBlock x:Name="FoldersText" Style="{StaticResource Mono}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0" Click="OnOpenLogsClicked" Content="Open log folder" />
                    <ui:Button Click="OnOpenSettingsClicked" Content="Open settings folder" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
